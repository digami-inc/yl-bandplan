---
import BandCard from "./BandCard.vue";
import { bands } from "../bandplan";

export interface Props {
  priv: string;
}

const { priv } = Astro.props;

const activeBands = bands.filter(
  (band) =>
    priv == "all" || band.privileges.some((p) => p.classes.includes(priv))
);
---

<div>
  <div class="row row--grow-cards">
    {
      activeBands.map((band) => (
        <div class="col">
          <a href={`/band-${band.route}-${priv}`} class="card clickable">
            <BandCard band={band} priv={priv} width={180} />
          </a>
        </div>
      ))
    }
  </div>
</div>
